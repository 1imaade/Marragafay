{
  "cleanUrls": true,
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/contact", "dest": "/api/contact.js" },
    { "src": "/api/booking", "dest": "/api/booking.js" },
    { "src": "/api/public/send-booking-email", "dest": "/api/booking.js" },
    { "src": "/api/send-booking-email", "dest": "/api/booking.js" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/activities", "dest": "/activities.html" },
    { "src": "/en/activities", "dest": "/en/activities.html" },
    { "src": "/fr/activities", "dest": "/fr/activities.html" },
    { "src": "/es/activities", "dest": "/es/activities.html" },
    { "src": "/ar/activities", "dest": "/ar/activities.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/cancellation", "dest": "/cancellation.html" },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}