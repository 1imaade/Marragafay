{
  "cleanUrls": true,
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/contact", "dest": "/api/contact.js" },
    { "src": "/api/booking", "dest": "/api/booking.js" },
    { "src": "/api/public/send-booking-email", "dest": "/api/booking.js" },
    { "src": "/api/send-booking-email", "dest": "/api/booking.js" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/activities", "dest": "/activities.html" },
    { "src": "/en/activities", "dest": "/en/activities.html" },
    { "src": "/fr/activities", "dest": "/fr/activities.html" },
    { "src": "/es/activities", "dest": "/es/activities.html" },
    { "src": "/ar/activities", "dest": "/ar/activities.html" },
    { "src": "/terms", "dest": "/terms.html" },
    { "src": "/privacy", "dest": "/privacy.html" },
    { "src": "/cancellation", "dest": "/cancellation.html" },
    { "src": "/blog", "dest": "/blog.html" },
    { "src": "/en/blog", "dest": "/en/blog/index.html" },
    { "src": "/fr/blog", "dest": "/fr/blog/index.html" },
    { "src": "/es/blog", "dest": "/es/blog/index.html" },
    { "src": "/ar/blog", "dest": "/ar/blog/index.html" },
    { "src": "/en/blog/(.*)", "dest": "/en/blog/$1.html" },
    { "src": "/fr/blog/(.*)", "dest": "/fr/blog/$1.html" },
    { "src": "/es/blog/(.*)", "dest": "/es/blog/$1.html" },
    { "src": "/ar/blog/(.*)", "dest": "/ar/blog/$1.html" },
    { "src": "/en/(agafay-desert-guide|agafay-camel-ride|agafay-desert-vs-sahara|agafay-dinner-experience|agafay-quad-biking-guide|berber-culture-agafay|marrakech-to-agafay)", "dest": "/en/blog/$1.html" },
    { "src": "/fr/(agafay-desert-guide|agafay-camel-ride|agafay-desert-vs-sahara|agafay-dinner-experience|agafay-quad-biking-guide|berber-culture-agafay|marrakech-to-agafay)", "dest": "/fr/blog/$1.html" },
    { "src": "/es/(agafay-desert-guide|agafay-camel-ride|agafay-desert-vs-sahara|agafay-dinner-experience|agafay-quad-biking-guide|berber-culture-agafay|marrakech-to-agafay)", "dest": "/es/blog/$1.html" },
    { "src": "/ar/(agafay-desert-guide|agafay-camel-ride|agafay-desert-vs-sahara|agafay-dinner-experience|agafay-quad-biking-guide|berber-culture-agafay|marrakech-to-agafay)", "dest": "/ar/blog/$1.html" },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(media|images|css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
