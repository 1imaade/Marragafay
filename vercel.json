{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/activities", "destination": "/activities.html" },
    { "source": "/en/activities", "destination": "/en/activities.html" },
    { "source": "/fr/activities", "destination": "/fr/activities.html" },
    { "source": "/es/activities", "destination": "/es/activities.html" },
    { "source": "/ar/activities", "destination": "/ar/activities.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "version": 2,
  "builds": [
    {
      "src": "**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    }
  ]
}